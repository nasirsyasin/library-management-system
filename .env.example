# Docker Compose uses published Docker Hub images from this namespace.
DOCKERHUB_NAMESPACE=nasirsyasin
IMAGE_TAG=latest

# These credentials are placeholders. Set unique local values before starting.
# Local npm processes connect through the published localhost ports.
CATALOG_DB_HOST=catalog-db
CATALOG_DB_PORT=5432
CATALOG_DB_LOCAL_PORT=15432
CATALOG_DB_NAME=catalog
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=

BORROW_DB_HOST=borrow-db
BORROW_DB_PORT=5432
BORROW_DB_LOCAL_PORT=15433
BORROW_DB_NAME=borrow
BORROW_DB_USER=borrow_user
BORROW_DB_PASSWORD=

RESERVATION_DB_HOST=reservation-db
RESERVATION_DB_PORT=5432
RESERVATION_DB_LOCAL_PORT=15434
RESERVATION_DB_NAME=reservation
RESERVATION_DB_USER=reservation_user
RESERVATION_DB_PASSWORD=

IDENTITY_DB_HOST=identity-db
IDENTITY_DB_PORT=5432
IDENTITY_DB_LOCAL_PORT=15435
IDENTITY_DB_NAME=identity
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=

JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Library Administrator

# OAuth provider credentials are reserved configuration fields; OAuth login
# routes are not implemented in the current application.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
