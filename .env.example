# Local PostgreSQL URLs for npm-run services and Drizzle Kit.
# DATABASE_URL=postgresql://username:password@localhost:5432/library_management
CATALOG_DATABASE_URL=postgresql://catalog_user:change-me@127.0.0.1:15432/catalog
BORROW_DATABASE_URL=postgresql://borrow_user:change-me@127.0.0.1:15433/borrow
RESERVATION_DATABASE_URL=postgresql://reservation_user:change-me@127.0.0.1:15434/reservation

# PostgreSQL credentials used by Docker Compose.
CATALOG_DB_HOST=catalog-db
CATALOG_DB_PORT=5432
CATALOG_DB_LOCAL_PORT=15432
CATALOG_DB_NAME=catalog
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=change-me

BORROW_DB_HOST=borrow-db
BORROW_DB_PORT=5432
BORROW_DB_LOCAL_PORT=15433
BORROW_DB_NAME=borrow
BORROW_DB_USER=borrow_user
BORROW_DB_PASSWORD=change-me

RESERVATION_DB_HOST=reservation-db
RESERVATION_DB_PORT=5432
RESERVATION_DB_LOCAL_PORT=15434
RESERVATION_DB_NAME=reservation
RESERVATION_DB_USER=reservation_user
RESERVATION_DB_PASSWORD=change-me

GATEWAY_DATABASE_URL=postgresql://identity_user:change-me@127.0.0.1:15435/identity
IDENTITY_DB_HOST=identity-db
IDENTITY_DB_PORT=5432
IDENTITY_DB_LOCAL_PORT=15435
IDENTITY_DB_NAME=identity
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=change-me

JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ReplaceWithUniquePassword2026!
ADMIN_NAME=Library Administrator
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

CATALOG_SERVICE_URL=http://localhost:8081
BORROW_SERVICE_URL=http://localhost:8082
RESERVATION_SERVICE_URL=http://localhost:8083
