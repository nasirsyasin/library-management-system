{
  "name": "api-gateway",
  "version": "0.1.0",
  "description": "Entry point / ingress. Handles OAuth2 login and JWT issuing (Identity and Access), then routes requests to the domain services.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "admin:reset-password": "npm run build && node dist/reset-password.js",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "node dist/db/migrate.js",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-http-proxy": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-http-proxy": "^1.6.7",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
